{
  "name": "abrelo-gift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "dev:runtime": "vite --mode runtime --host 0.0.0.0 --port 1421",
    "dev:worker": "npm run build:runtime && wrangler dev --port 8787",
    "test": "vitest run",
    "test:worker": "vitest run worker",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "build": "tsc && vite build",
    "build:runtime": "tsc && vite build --mode runtime",
    "build:worker": "npm run build:runtime && wrangler deploy --dry-run --outdir dist-worker",
    "check:runtime-bundle": "node scripts/check-runtime-bundle.mjs",
    "db:migrate:local": "wrangler d1 migrations apply abrelo-published-gifts --local",
    "deploy:worker": "npm run build:runtime && wrangler deploy",
    "preview": "vite preview",
    "preview:runtime": "vite preview --mode runtime --port 4174",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tauri-apps/api": "2.11.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "^5.9.0",
    "vite": "8.2.1",
    "vitest": "^4.0.0",
    "wrangler": "^4.125.0"
  }
}
